rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Projects Showcase (Public Read, Public Sync with Valid Project Structure or Authenticated)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated() || (
        request.resource.data.title is string &&
        request.resource.data.category is string
      );
    }

    // 2. Pricing Plans (Public Read, Public Sync with Valid Pricing Structure or Authenticated)
    match /pricing/{planId} {
      allow read: if true;
      allow write: if isAuthenticated() || (
        request.resource.data.name is string &&
        request.resource.data.price is string
      );
    }

    // 3. Purchase Orders (Public Create with Validation, Admin Read/Update/Delete)
    match /purchaseOrders/{orderId} {
      allow create: if request.resource.data.clientName is string &&
                       request.resource.data.clientEmail is string &&
                       request.resource.data.planName is string;
      allow read, update, delete: if true;
    }

    // 4. Global Multi-Device Realtime System Snapshot (Public Read, Live Sync Write with Valid Schema)
    match /system_snapshot/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || 
                      request.resource.data.projects is list || 
                      request.resource.data.pricingPlans is list;
    }

    // 5. Default Secure Access
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

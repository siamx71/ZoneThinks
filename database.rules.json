{
  "rules": {
    "system_snapshot": {
      ".read": true,
      ".write": true
    },
    "projects": {
      ".read": true,
      ".write": true
    },
    "pricingPlans": {
      ".read": true,
      ".write": true
    },
    "purchaseOrders": {
      ".read": true,
      "$orderId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['clientName', 'clientEmail', 'planName', 'price'])"
      }
    },
    "$other": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}